# Environment variables for the Retail Memory Assistant

# Cognee API endpoint
COGNEE_API_URL=http://127.0.0.1:8102

# Cognee MCP HTTP endpoint
COGNEE_MCP_URL=http://127.0.0.1:8101/mcp

# Product API endpoint
PRODUCT_API_URL=http://127.0.0.1:8000

# Streamlit application port
STREAMLIT_PORT=8501

# Optional: LLM configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_MODEL=mistral